{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    { "src": "api/search.js", "use": "@vercel/node" },
    { "src": "api/entitlement/verify.js", "use": "@vercel/node" },
    { "src": "api/entitlement/trip-pass.js", "use": "@vercel/node" },
    { "src": "api/entitlement/apple-notifications.js", "use": "@vercel/node" },
    { "src": "api/entitlement/google-notifications.js", "use": "@vercel/node" },
    { "src": "api/live-polygon-e2e.js", "use": "@vercel/node" },
    { "src": "api/live-topk-modes-e2e.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "/api/search.js" },
    { "src": "/api/entitlement/verify", "dest": "/api/entitlement/verify.js" },
    { "src": "/api/entitlement/trip-pass", "dest": "/api/entitlement/trip-pass.js" },
    { "src": "/api/entitlement/apple-notifications", "dest": "/api/entitlement/apple-notifications.js" },
    { "src": "/api/entitlement/google-notifications", "dest": "/api/entitlement/google-notifications.js" },
    { "src": "/api/live-polygon-e2e", "dest": "/api/live-polygon-e2e.js" },
    { "src": "/api/live-topk-modes-e2e", "dest": "/api/live-topk-modes-e2e.js" }
  ]
}
