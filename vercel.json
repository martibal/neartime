{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "android-native/app/src/main/res/drawable-nodpi/ic_launcher_full.png",
      "use": "@vercel/static"
    },
    {
      "src": "legal/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/native.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search-topk.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/entitlement/verify.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/entitlement/topup.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/entitlement/trip-pass.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/entitlement/apple-notifications.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/entitlement/google-notifications.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/app-icon.png",
      "dest": "/android-native/app/src/main/res/drawable-nodpi/ic_launcher_full.png"
    },
    {
      "src": "/privacy",
      "dest": "/legal/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/legal/terms.html"
    },
    {
      "src": "/api/native",
      "dest": "/api/native.js"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/search-topk",
      "dest": "/api/search-topk.js"
    },
    {
      "src": "/api/entitlement/verify",
      "dest": "/api/entitlement/verify.js"
    },
    {
      "src": "/api/entitlement/topup",
      "dest": "/api/entitlement/topup.js"
    },
    {
      "src": "/api/entitlement/trip-pass",
      "dest": "/api/entitlement/trip-pass.js"
    },
    {
      "src": "/api/entitlement/apple-notifications",
      "dest": "/api/entitlement/apple-notifications.js"
    },
    {
      "src": "/api/entitlement/google-notifications",
      "dest": "/api/entitlement/google-notifications.js"
    }
  ]
}
