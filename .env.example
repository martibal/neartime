# Build-time only. Never commit the real Google Maps Android key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Public URL of the NearTime backend. Safe to expose in the mobile bundle.
EXPO_PUBLIC_NEARTIME_SEARCH_ENDPOINT=

# Backend-only. Never prefix these with EXPO_PUBLIC_ and never put real values in Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_SERVER_API_KEY=
