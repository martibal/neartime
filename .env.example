# Build-time only. Never commit the real Google Maps Android key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Public URL of the NearTime backend. Safe to expose in the mobile bundle.
EXPO_PUBLIC_NEARTIME_SEARCH_ENDPOINT=

# Backend-only. Never prefix these with EXPO_PUBLIC_ and never put real values in Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_SERVER_API_KEY=
TOMTOM_API_KEY=

# Pseudonymous entitlement identity. Use a long random secret; rotating it requires
# an explicit wallet migration because it defines the HMAC identity namespace.
ENTITLEMENT_HMAC_SECRET=

# Apple App Store Server API / Notifications V2.
APPLE_BUNDLE_ID=com.martibal.neartime
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_P8=
# Comma-separated DER certificates encoded as base64. Keep server-side only.
APPLE_ROOT_CA_CERTS_BASE64=

# Google Play Developer API + authenticated Pub/Sub push for RTDN.
GOOGLE_PLAY_PACKAGE_NAME=com.placefinder.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
